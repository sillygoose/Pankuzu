INSERT INTO trips (id, originID, destinationID, timeStart, duration, deleted) VALUES ('trip2', 'locB', 'locA', '2025-08-15T08:30:00Z', 1.5, NULL);

-- Add a charge referencing locA
INSERT INTO charges (id, locationID, timeStart, duration, deleted) VALUES ('charge1', 'locB', '2025-08-15T08:10:00Z', 0.5, NULL);

-- Check that locations are not deleted
SELECT * FROM locations;

-- Soft-delete the trip (locA is still referenced by the charge, so stays undeleted)
UPDATE trips SET deleted = '2025-08-15T10:00:00Z' WHERE id = 'trip1';
--UPDATE trips SET deleted = '2025-08-15T10:00:00Z' WHERE id = 'trip2';
SELECT * FROM locations;
SELECT * FROM trips;

-- Soft-delete the charge (now locA has no non-deleted referencing trips or charges, so should become soft-deleted)
UPDATE charges SET deleted = '2025-08-15T11:00:00Z' WHERE id = 'charge1';
SELECT * FROM locations;
SELECT * FROM trips;
SELECT * FROM charges;

-- Restore the trip (location should also be undeleted)
UPDATE trips SET deleted = NULL WHERE id = 'trip1';
UPDATE trips SET deleted = NULL WHERE id = 'trip2';
SELECT * FROM locations;

-- First, soft-delete the trip again so the location will be soft-deleted
UPDATE trips SET deleted = '2025-08-15T12:00:00Z' WHERE id = 'trip1';
UPDATE trips SET deleted = '2025-08-15T12:00:00Z' WHERE id = 'trip2';

-- Now, hard-delete the trip (should hard-delete locA if it's the last ref)
DELETE FROM trips WHERE id = 'trip1';
DELETE FROM trips WHERE id = 'trip2';
