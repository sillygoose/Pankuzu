DROP TABLE IF EXISTS locations;
DROP TABLE IF EXISTS trips;
DROP TABLE IF EXISTS charges;

CREATE TABLE "locations" (
  "id" TEXT PRIMARY KEY NOT NULL ON CONFLICT REPLACE DEFAULT (uuid()),
  "deleted" TEXT,
  "name" TEXT
) STRICT;

CREATE TABLE "trips" (
  "id" TEXT PRIMARY KEY NOT NULL ON CONFLICT REPLACE DEFAULT (uuid()),
  "deleted" TEXT,
  "originID" TEXT NOT NULL,
  "destinationID" TEXT NOT NULL,
  "timeStart" TEXT NOT NULL,
  "duration" REAL NOT NULL,
  FOREIGN KEY("originID") REFERENCES "locations"("id")
  FOREIGN KEY("destinationID") REFERENCES "locations"("id")
) STRICT;

CREATE TABLE "charges" (
  "id" TEXT PRIMARY KEY NOT NULL ON CONFLICT REPLACE DEFAULT (uuid()),
  "deleted" TEXT,
  "locationID" TEXT NOT NULL,
  "timeStart" TEXT NOT NULL,
  "duration" REAL NOT NULL,
  FOREIGN KEY("locationID") REFERENCES "locations"("id")
) STRICT;

-- Trigger to mark location as deleted when last referencing trip is soft deleted
CREATE TRIGGER mark_location_deleted_after_trip_soft_delete
AFTER UPDATE OF deleted ON trips
WHEN NEW.deleted IS NOT NULL AND OLD.deleted IS NULL
BEGIN
  UPDATE locations
    SET deleted = NEW.deleted
    WHERE id = NEW.originID
      AND deleted IS NULL
      AND (
        (SELECT COUNT(*) FROM trips WHERE (originID = NEW.originID OR destinationID = NEW.originID) AND deleted IS NULL) = 0
        AND (SELECT COUNT(*) FROM charges WHERE locationID = NEW.originID AND deleted IS NULL) = 0
      );
  UPDATE locations
    SET deleted = NEW.deleted
    WHERE id = NEW.destinationID
      AND deleted IS NULL
      AND (
        (SELECT COUNT(*) FROM trips WHERE (originID = NEW.destinationID OR destinationID = NEW.destinationID) AND deleted IS NULL) = 0
        AND (SELECT COUNT(*) FROM charges WHERE locationID = NEW.destinationID AND deleted IS NULL) = 0
      );
END;

-- Trigger to mark location as deleted when last referencing charge is soft deleted
CREATE TRIGGER mark_location_deleted_after_charge_soft_delete
AFTER UPDATE OF deleted ON charges
WHEN NEW.deleted IS NOT NULL AND OLD.deleted IS NULL
BEGIN
  UPDATE locations
    SET deleted = NEW.deleted
    WHERE id = NEW.locationID
      AND deleted IS NULL
      AND (
        (SELECT COUNT(*) FROM trips WHERE (originID = NEW.locationID OR destinationID = NEW.locationID) AND deleted IS NULL) = 0
        AND (SELECT COUNT(*) FROM charges WHERE locationID = NEW.locationID AND deleted IS NULL) = 0
      );
END;

-- Trigger to undelete location on new trip insert
CREATE TRIGGER undelete_location_on_trip_insert
AFTER INSERT ON trips
BEGIN
  UPDATE locations SET deleted = NULL WHERE id = NEW.originID AND deleted IS NOT NULL;
  UPDATE locations SET deleted = NULL WHERE id = NEW.destinationID AND deleted IS NOT NULL;
END;

-- Trigger to undelete location on new charge insert
CREATE TRIGGER undelete_location_on_charge_insert
AFTER INSERT ON charges
BEGIN
  UPDATE locations SET deleted = NULL WHERE id = NEW.locationID AND deleted IS NOT NULL;
END;

-- Trigger to undelete location if any referencing trip is restored (deleted goes from non-null to null)
CREATE TRIGGER undelete_location_on_trip_restore
AFTER UPDATE OF deleted ON trips
WHEN OLD.deleted IS NOT NULL AND NEW.deleted IS NULL
BEGIN
  UPDATE locations SET deleted = NULL WHERE id = NEW.originID AND deleted IS NOT NULL;
  UPDATE locations SET deleted = NULL WHERE id = NEW.destinationID AND deleted IS NOT NULL;
END;

-- Trigger to undelete location if any referencing charge is restored (deleted goes from non-null to null)
CREATE TRIGGER undelete_location_on_charge_restore
AFTER UPDATE OF deleted ON charges
WHEN OLD.deleted IS NOT NULL AND NEW.deleted IS NULL
BEGIN
  UPDATE locations SET deleted = NULL WHERE id = NEW.locationID AND deleted IS NOT NULL;
END;

-- Hard delete locations when last referencing trip is deleted (on trip delete)
CREATE TRIGGER hard_delete_location_after_trip_delete
AFTER DELETE ON trips
BEGIN
  DELETE FROM locations WHERE id = OLD.originID
    AND (
      (SELECT COUNT(*) FROM trips WHERE (originID = OLD.originID OR destinationID = OLD.originID)) = 0
      AND (SELECT COUNT(*) FROM charges WHERE locationID = OLD.originID) = 0
    );
  DELETE FROM locations WHERE id = OLD.destinationID
    AND (
      (SELECT COUNT(*) FROM trips WHERE (originID = OLD.destinationID OR destinationID = OLD.destinationID)) = 0
      AND (SELECT COUNT(*) FROM charges WHERE locationID = OLD.destinationID) = 0
    );
END;

-- Hard delete locations when last referencing charge is deleted (on charge delete)
CREATE TRIGGER hard_delete_location_after_charge_delete
AFTER DELETE ON charges
BEGIN
  DELETE FROM locations WHERE id = OLD.locationID
    AND (
      (SELECT COUNT(*) FROM trips WHERE (originID = OLD.locationID OR destinationID = OLD.locationID)) = 0
      AND (SELECT COUNT(*) FROM charges WHERE locationID = OLD.locationID) = 0
    );
END;

-- End of triggers

